; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deterministic Cloth (MuJoCo sandbox)"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7")

[editor_plugins]

enabled=PackedStringArray("res://addons/cineform/plugin.cfg", "res://addons/mujoco/plugin.cfg", "res://addons/vsekai_godot_mcp/plugin.cfg")

[rendering]

anti_aliasing/quality/msaa_3d=2

[sandbox]

toolchain/skip_dependency_check=true
