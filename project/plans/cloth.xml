<mujoco model="garment_drape">
  <extension>
    <plugin plugin="mujoco.elasticity.shell" />
  </extension>
  <option timestep="0.001" gravity="0 0 -9.81" solver="Newton" integrator="implicitfast" tolerance="1e-10" />
  <worldbody>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.2 0.2 0.22 1" />
    <body name="panel" pos="-0.2500 0 1.2000">
      <flexcomp name="panel" type="grid" count="24 34 1" spacing="0.02174 0.02121 0.01" dim="2" mass="0.05" radius="0.003" rgba="0.7 0.3 0.4 1">
        <edge equality="true" />
        <pin id="792 793 794 795 796 797 798 799 800 801 802 803 804 805 806 807 808 809 810 811 812 813 814 815" />
        <plugin plugin="mujoco.elasticity.shell">
          <config key="thickness" value="1e-3" />
          <config key="youngs" value="3e4" />
          <config key="poisson" value="0.3" />
        </plugin>
      </flexcomp>
    </body>
  </worldbody>
</mujoco>
